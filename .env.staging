# ===========================================
# SParking - Staging Environment Configuration
# ===========================================
# This is a TEMPLATE. Replace all STAGING_* placeholder values
# with real staging credentials before use.
# Generate secrets with: openssl rand -base64 32

# ===========================================
# Application Core
# ===========================================
NODE_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.sparking.app
NEXT_PUBLIC_APP_NAME=SParking (Staging)

# ===========================================
# Database (PostgreSQL) - REQUIRED
# ===========================================
# Use a dedicated staging database, never share with production
DATABASE_URL="postgresql://STAGING_DB_USER:STAGING_DB_PASSWORD@STAGING_DB_HOST:5432/sparking_staging?schema=public"

# ===========================================
# Authentication - REQUIRED
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET="STAGING_JWT_SECRET_CHANGE_ME"

# ===========================================
# AI Pipeline Detection API Key - REQUIRED
# ===========================================
# Generate with: openssl rand -hex 32
DETECTION_API_KEY="STAGING_DETECTION_API_KEY_CHANGE_ME"

# ===========================================
# WebSocket / Realtime
# ===========================================
NEXT_PUBLIC_SOCKET_URL=https://staging.sparking.app

# ===========================================
# Session Management
# ===========================================
MAX_SESSIONS_PER_USER=5

# ===========================================
# CORS Configuration
# ===========================================
# Include staging and local origins for testing
ALLOWED_ORIGINS=https://staging.sparking.app,http://localhost:3000

# ===========================================
# Email Configuration
# ===========================================
# Use SendGrid or Resend for staging; avoid "console" to test real delivery
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=SParking Staging <noreply@staging.sparking.app>

# SendGrid (use a staging-specific API key with limited permissions)
SENDGRID_API_KEY=STAGING_SENDGRID_API_KEY

# SMTP alternative (uncomment if using SMTP instead)
# SMTP_HOST=STAGING_SMTP_HOST
# SMTP_PORT=587
# SMTP_USER=STAGING_SMTP_USER
# SMTP_PASSWORD=STAGING_SMTP_PASSWORD
# SMTP_FROM=noreply@staging.sparking.app

# Resend alternative (uncomment if using Resend instead)
# RESEND_API_KEY=STAGING_RESEND_API_KEY

# ===========================================
# SMS Gateway
# ===========================================
# Use test credentials or sandbox mode for staging
SMS_PROVIDER=twilio

# Twilio (use test credentials for staging)
TWILIO_ACCOUNT_SID=STAGING_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=STAGING_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15005550006

# MSG91 alternative (uncomment if using MSG91)
# MSG91_AUTH_KEY=STAGING_MSG91_AUTH_KEY
# MSG91_SENDER_ID=SPARKN
# MSG91_TEMPLATE_ID=STAGING_MSG91_TEMPLATE_ID

# ===========================================
# Payment Gateway
# ===========================================
# Use test/sandbox keys for staging - NEVER use live keys

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_STAGING_KEY_ID
RAZORPAY_KEY_SECRET=STAGING_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=STAGING_RAZORPAY_WEBHOOK_SECRET

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_STAGING_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_STAGING_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_STAGING_STRIPE_PK

# ===========================================
# File Storage
# ===========================================
# Use S3 with a staging-specific bucket, or local for simplicity
STORAGE_PROVIDER=local

# AWS S3 (uncomment if using S3 for staging)
# AWS_ACCESS_KEY_ID=STAGING_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=STAGING_AWS_SECRET_KEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=sparking-staging-uploads

# ===========================================
# Redis
# ===========================================
# Staging Redis instance (used by docker-compose.staging.yml)
REDIS_URL=redis://redis:6379

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# Rate Limiting
# ===========================================
# Relaxed rate limits for staging to facilitate testing
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# ===========================================
# Security
# ===========================================
# Cron job secret
CRON_SECRET=STAGING_CRON_SECRET_CHANGE_ME

# Encryption key for sensitive data (camera credentials, etc.)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=STAGING_ENCRYPTION_KEY_CHANGE_ME

# ===========================================
# Analytics
# ===========================================
# Leave empty or use a staging-specific analytics ID
NEXT_PUBLIC_ANALYTICS_ID=

# ===========================================
# Microsoft Entra ID (Azure AD) - Server-side OAuth2 + PKCE
# ===========================================
# Use a staging app registration in Azure AD.
# Redirect URI must be registered as "Web" type (NOT "SPA") in Azure Portal.
# Add your staging root URL as the redirect URI.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=STAGING_AZURE_AD_CLIENT_ID
NEXT_PUBLIC_AZURE_AD_TENANT_ID=STAGING_AZURE_AD_TENANT_ID
AZURE_AD_CLIENT_SECRET=STAGING_AZURE_AD_CLIENT_SECRET
AZURE_AD_AUTO_CREATE_USERS=true
AZURE_AD_DEFAULT_ROLE=ADMIN

# ===========================================
# Docker Compose Service Configuration
# ===========================================
# Used by docker-compose.staging.yml
POSTGRES_USER=sparking_staging
POSTGRES_PASSWORD=STAGING_POSTGRES_PASSWORD_CHANGE_ME
POSTGRES_DB=sparking_staging
