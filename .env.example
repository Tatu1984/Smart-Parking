# ===========================================
# SParking - Smart Parking Management System
# Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in the values
# Generate secrets with: openssl rand -base64 32

# ===========================================
# REQUIRED - Application Core
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SParking

# Database (PostgreSQL) - REQUIRED
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/sparking?schema=public"

# Authentication - REQUIRED (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# AI Pipeline Detection API Key - REQUIRED for detection endpoint
# Generate with: openssl rand -hex 32
DETECTION_API_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ===========================================
# OPTIONAL - Features
# ===========================================

# WebSocket (Socket.IO)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Session Management
MAX_SESSIONS_PER_USER=5

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# OPTIONAL - Email Configuration
# ===========================================

# Email Provider: console (default), resend, sendgrid, smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Sparking <noreply@sparking.app>

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# ===========================================
# OPTIONAL - SMS Gateway
# ===========================================

# SMS Provider: twilio, msg91
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 (India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SPARKN
MSG91_TEMPLATE_ID=your-template-id

# ===========================================
# OPTIONAL - Payment Gateway
# ===========================================

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ===========================================
# OPTIONAL - File Storage
# ===========================================

# Storage Provider: local, s3
STORAGE_PROVIDER=local

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sparking-uploads

# ===========================================
# OPTIONAL - AI Pipeline
# ===========================================

AI_PIPELINE_ENABLED=true
AI_PIPELINE_DEVICE=CPU
AI_PIPELINE_CONFIDENCE_THRESHOLD=0.5

# MQTT (for AI pipeline communication)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=sparking/detection

# ===========================================
# OPTIONAL - Logging & Monitoring
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================
# OPTIONAL - Rate Limiting
# ===========================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# OPTIONAL - Security
# ===========================================

# Cron job secret for scheduled tasks
CRON_SECRET=your-cron-secret

# Encryption key for sensitive data (camera credentials, etc.)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ===========================================
# OPTIONAL - Analytics
# ===========================================

NEXT_PUBLIC_ANALYTICS_ID=

# ===========================================
# OPTIONAL - Microsoft Entra ID (Azure AD)
# ===========================================
# Server-side OAuth2 with PKCE flow. No client-side MSAL packages needed.
#
# Setup:
#   1. Register an app in Azure Portal > App registrations
#   2. Under Authentication > Add platform > "Web" (NOT "SPA")
#   3. Add redirect URIs: your app's root URL (e.g. https://myapp.azurewebsites.net)
#   4. Under Certificates & secrets > New client secret > copy the value
#   5. Fill in the values below
#
# How it works:
#   - User clicks "Sign in with Microsoft" → server redirects to Microsoft
#   - Microsoft redirects back to your root URL with ?code=&state=
#   - page.tsx detects the params and forwards to /api/auth/microsoft/callback
#   - Callback exchanges the code for tokens using PKCE + client_secret
#   - Session is created and user is redirected to /dashboard
#
# IMPORTANT for Azure App Service deployments:
#   - The app resolves its public URL via WEBSITE_HOSTNAME (auto-set by Azure)
#     or NEXT_PUBLIC_APP_URL. request.nextUrl.origin returns the internal
#     container address (0.0.0.0:3000) and CANNOT be used for OAuth redirect URIs.

# Azure AD Application (Client) ID
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=

# Azure AD Tenant ID (use 'common' for multi-tenant)
NEXT_PUBLIC_AZURE_AD_TENANT_ID=common

# Azure AD Client Secret (REQUIRED - from Certificates & secrets in Azure Portal)
# The redirect URI must be registered as "Web" type (not "SPA") in Azure AD.
AZURE_AD_CLIENT_SECRET=

# Auto-create users on first Microsoft login (true/false)
AZURE_AD_AUTO_CREATE_USERS=true

# Default role for auto-created users (SUPER_ADMIN, ADMIN, OPERATOR, AUDITOR, VIEWER)
AZURE_AD_DEFAULT_ROLE=ADMIN

# Default organization ID for auto-created users (optional, uses first org if not set)
# AZURE_AD_DEFAULT_ORGANIZATION_ID=

# ===========================================
# OPTIONAL - Metro AI Suite Integration
# ===========================================

# Intel DL Streamer Pipeline Server
DLSTREAMER_IMAGE=intel/dlstreamer-pipeline-server:latest
DLSTREAMER_ENDPOINT=http://dlstreamer-pipeline-server:8080

# Metro MQTT Configuration
METRO_MQTT_TOPIC_PREFIX=object_detection

# Camera-to-Topic Mapping (JSON format for mqtt-translator)
# Example: {"1": "camera-uuid-1", "2": "camera-uuid-2"}
CAMERA_MAPPING=

# Node-RED credential secret (optional, for encrypting Node-RED credentials)
NODE_RED_CREDENTIAL_SECRET=

# ===========================================
# OPTIONAL - MilvusDB (Vehicle Image Search)
# ===========================================

# Milvus endpoint
MILVUS_ENDPOINT=http://milvus-db:19530

# Milvus collection name for vehicle features
MILVUS_COLLECTION=sparking_vehicles

# Feature extraction model dimension (depends on model used)
# ResNet50 = 2048, EfficientNet-B0 = 1280, MobileNetV3 = 1000
FEATURE_MODEL_DIM=1000

# Feature matching service endpoint
FEATURE_MATCHING_ENDPOINT=http://feature-matching:8000

# ===========================================
# CCTV STREAMING (MediaMTX) - see docs/cctv/env.md
# ===========================================

# MediaMTX CONTROL API (server-side only). The backend registers camera pull
# paths here. Keep this on the internal network — never expose it publicly.
MEDIAMTX_CONTROL_URL=http://mediamtx:9997

# BROWSER-reachable playback bases. In production these are PUBLIC hostnames
# fronted by your reverse proxy (TLS), NOT the internal service name.
MEDIAMTX_HLS_BASE=http://localhost:8888
MEDIAMTX_ENDPOINT=http://localhost:8889

# Publisher credentials — the "camera side" secret used to push streams into
# MediaMTX. MUST match MTX_PUBLISH_USER/PASS in docker/mediamtx config.
# Generate with: openssl rand -base64 24
MEDIAMTX_PUBLISH_USER=sparking_pub
MEDIAMTX_PUBLISH_PASS=change_me_publisher_secret

# Control-API request timeout (ms).
MEDIAMTX_TIMEOUT_MS=5000

# Camera health worker (bootstrapped in-process by Next instrumentation).
# Set to 'true' on exactly ONE instance (or run it as a standalone worker).
CAMERA_HEALTH_WORKER_ENABLED=true
CAMERA_HEALTH_POLL_INTERVAL_MS=15000

# --- WebRTC ICE/TURN (optional, low-latency playback behind NAT) ---
# Format: turn:hostname:port or stun:hostname:port
WEBRTC_ICE_SERVERS=turn:localhost:3478
TURN_USERNAME=sparking
TURN_PASSWORD=sparking_secret

# --- Edge push ingest (Phase 2: cameras behind NAT/CGNAT) ---
# On-site Edge Agents upload HLS segments here over outbound HTTPS. See
# docs/cctv/edge-agent.md. Local directory where ingested segments are stored.
EDGE_INGEST_DIR=./.edge-hls
# Browser-reachable base for edge HLS playback (the public app URL in prod).
EDGE_INGEST_PUBLIC_BASE=http://localhost:3000
# A pushed stream is considered live if its playlist was updated within this
# many ms (the agent rewrites index.m3u8 every ~2s).
EDGE_FRESHNESS_MS=20000
# Secret used to hash per-camera ingest tokens (defaults to ENCRYPTION_KEY).
# INGEST_TOKEN_SECRET=

# ===========================================
# OPTIONAL - Grafana Monitoring
# ===========================================

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sparking_admin

# Grafana root URL (if behind reverse proxy)
GRAFANA_ROOT_URL=http://localhost/grafana

# ===========================================
# OPTIONAL - GStreamer Debug (DL Streamer)
# ===========================================

# GStreamer debug level (0=none, 1=error, 2=warning, 3=info, 4=debug, 5=log)
GST_DEBUG=1
