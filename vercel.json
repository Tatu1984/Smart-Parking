{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/payments/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/*/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/analytics/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/evaluate-alerts",
      "schedule": "*/5 * * * *"
    }
  ]
}
